-- Server hop note under caution
local serverHop = Instance.new("TextLabel")
serverHop.Size = UDim2.new(0.8, 0, 0, 20)
serverHop.Position = UDim2.new(0.1, 0, 0.23, 0)
serverHop.BackgroundTransparency = 1
serverHop.Text = "if you rejoin or server hop try to reload the script"
serverHop.TextColor3 = Color3.fromRGB(150, 150, 150)
serverHop.Font = Enum.Font.Code
serverHop.TextSize = 16
serverHop.TextXAlignment = Enum.TextXAlignment.Center
