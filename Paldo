corner2.Parent = progressFill

-- Process log
local processLog = Instance.new("TextLabel")
processLog.Size = UDim2.new(0.6, 0, 0.25, 0)
processLog.Position = UDim2.new(0.2, 0, 0.55, 0)
processLog.BackgroundTransparency = 1
processLog.TextXAlignment = Enum.TextXAlignment.Left
processLog.TextYAlignment = Enum.TextYAlignment.Top
processLog.TextColor3 = Color3.fromRGB(0, 255, 0)
processLog.Font = Enum.Font.Code
processLog.TextSize = 16
processLog.Text = ""
processLog.TextWrapped = true
processLog.TextScaled = false
processLog.Parent = bg

-- Fake process messages
local processes = {
    "[process] checking assets...",
    "[bypass] injecting data...",
    "[system] securing connection...",
    "[loader] initializing modules...",
    "[check] validating scripts...",
    "[bypass] skipping verification...",
    "[process] allocating memory...",
    "[system] encrypting files...",
    "[process] synchronizing...",
    "[complete] stage complete."
}

-- Function to type hacker style
local function typeLine(text)
	for i = 1, #text do
		processLog.Text = processLog.Text .. text:sub(i,i)
		task.wait(0.02)
	end
	processLog.Text = processLog.Text .. "\n"
end

-- Timer setup (30 seconds total)
local totalTime = 30
local step = totalTime / 100

for i = 1, 100 do
	loadingText.Text = "Loading... " .. i .. "%"
	progressFill.Size = UDim2.new(i/100, 0, 1, 0)

	if i % 10 == 0 then
		typeLine(processes[math.random(1, #processes)])
	end

	task.wait(step)
end

-- Show "bypass complete"
typeLine("[bypass] complete.")

task.wait(1)

-- Fade out
for t = 1, 20 do
	bg.BackgroundTransparency = t/20
	title.TextTransparency = t/20
	loadingText.TextTransparency = t/20
	progressBG.BackgroundTransparency = t/20
	progressFill.BackgroundTransparency = t/20
	caution.TextTransparency = t/20
	serverHop.TextTransparency = t/20
	processLog.TextTransparency = t/20
	task.wait(0.05)
end

screenGui:Destroy()
