title.Font = Enum.Font.GothamBold
title.TextSize = 48
title.Parent = bg

-- ⚠ Caution under the title
local caution = Instance.new("TextLabel")
caution.Size = UDim2.new(0.8, 0, 0, 25)
caution.Position = UDim2.new(0.1, 0, 0.18, 0)
caution.BackgroundTransparency = 1
caution.Text = "⚠ do not leave the game while loading ⚠"
caution.TextColor3 = Color3.fromRGB(255, 255, 0)
caution.Font = Enum.Font.Code
caution.TextSize = 20
caution.TextXAlignment = Enum.TextXAlignment.Center
