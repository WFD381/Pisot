-- Blink caution
task.spawn(function()
	while caution.Parent do
		caution.TextColor3 = Color3.fromRGB(255, 255, 0)
		task.wait(0.5)
		caution.TextColor3 = Color3.fromRGB(255, 0, 0)
		task.wait(0.5)
	end
end)

-- Loading text
